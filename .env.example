# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose: "groq" (cloud, free, rate-limited) or "ollama" (local, no limit)
LLM_PROVIDER=groq

# ── Groq API (https://console.groq.com) ───────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama (local server) ──────────────────────────────────────────────────────
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434  # default

# ── Corpus storage (default: ./corpus) ────────────────────────────────────────
# CORPUS_DIR=/data/medrag_corpus

